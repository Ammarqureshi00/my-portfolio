# Your live domain (no trailing slash). Used for canonical URLs, sitemap, Open Graph & JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Contact details shown on the site (leave empty to hide)
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_GITHUB=
NEXT_PUBLIC_WHATSAPP=

# Google Search Console HTML-tag verification token (the content="" value only)
GOOGLE_SITE_VERIFICATION=
